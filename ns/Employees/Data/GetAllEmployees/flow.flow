interface Employees.Data
service GetAllEmployees (
    output {
        recordList TransformedEmployees {
            String EmployeeOutput;
        };
    }
)
properties {
    favorite: false;
    deprecated: false;
    visible: private;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    INVOKE HRDB:GetAllEmployees {
        validateInput: false
        validateOutput: false
    }
    LOOP {
        inputArray: "/GetAllEmployeesOutput/results"
        outputArray: "/TransformedEmployees"
        maxThreads: "1"
        parallelErrorHandling: "reportError"
        INVOKE Employees.Data:transformEmployee {
            validateInput: false
            validateOutput: false
            output {
                mapSource {
                    String EmployeeOutput;
                }
                mapTarget {
                    recordList TransformedEmployees {
                        String EmployeeOutput;
                    };
                }
                copy `EmployeeOutput` -> `TransformedEmployees`/`EmployeeOutput`;
            }
        }
    }
}
