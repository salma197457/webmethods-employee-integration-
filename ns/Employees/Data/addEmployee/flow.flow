interface Employees.Data
service addEmployee (
    input {
        String Description;
        String EmployeeName;
        String Email;
        String Phone;
        String Department;
        String JobTitle;
        BigDecimal Salary;
        Boolean IsActive;
        String hireDate;
    }
    output {
        Integer ReturnResult;
        String CorrelationID;
    }
)
properties {
    favorite: false;
    deprecated: false;
    visible: private;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    INVOKE Employees.Data:generateCorrelationId {
        validateInput: false
        validateOutput: false
    }
    BRANCH {
        evaluateLabels: true
        SEQUENCE {
            label: "Department == \"IT\""
            INVOKE HRDB:insertEmployee {
                validateInput: false
                validateOutput: false
                input {
                    mapTarget {
                        record insertEmployeeInput {
                            allowUnspecifiedFields: true;
                        } {
                            record overrideCredentials {
                                allowUnspecifiedFields: true;
                            };
                            String EmployeeName;
                            String Description;
                            String Email;
                            String Phone;
                            String JobTitle;
                            String Department;
                            BigDecimal Salary;
                            String HireDate;
                            Boolean IsActive;
                        };
                    }
                    copy `EmployeeName` -> `insertEmployeeInput`/`EmployeeName`;
                    copy `Email` -> `insertEmployeeInput`/`Email`;
                    copy `Phone` -> `insertEmployeeInput`/`Phone`;
                    copy `Department` -> `insertEmployeeInput`/`Department`;
                    copy `JobTitle` -> `insertEmployeeInput`/`JobTitle`;
                    copy `IsActive` -> `insertEmployeeInput`/`IsActive`;
                    copy `Salary` -> `insertEmployeeInput`/`Salary`;
                    copy `Description` -> `insertEmployeeInput`/`Description`;
                    copy `hireDate` -> `insertEmployeeInput`/`HireDate`;
                }
                output {
                    drop `insertEmployeeInput`;
                    drop `EmployeeName`;
                    drop `Description`;
                    drop `Email`;
                    drop `Phone`;
                    drop `Department`;
                    drop `JobTitle`;
                    drop `Salary`;
                    drop `IsActive`;
                    drop `test`;
                }
            }
            MAP {
                mapTarget {
                    String ReturnResult;
                    String CorrelationId;
                }
                drop `Salary`;
                drop `JobTitle`;
                drop `Department`;
                drop `Phone`;
                drop `Email`;
                drop `EmployeeName`;
                drop `Description`;
                drop `insertEmployeeInput`;
                drop `IsActive`;
                drop `insertEmployeeOutput`;
                copy `CorrelationId` -> `CorrelationId`;
                copy `insertEmployeeOutput` -> `ReturnResult`;
            }
            INVOKE pub.flow:debugLog {
                validateInput: false
                validateOutput: false
                input {
                    mapTarget {
                        String message;
                    }
                    set (variable, globalvariables) `message` = "%CorrelationId% Employee added successfully";
                }
            }
        }
        SEQUENCE {
            label: "$default"
            MAP {
                mapTarget {
                    record ErrorResponsee {
                        allowUnspecifiedFields: true;
                    } {
                        String errorMessage;
                        String correlationId;
                        String serviceName;
                        String errorCode;
                    };
                    String ReturnResult;
                }
                set `ReturnResult` = "0";
                set `ErrorResponsee`/`errorMessage` = "Error inserting employee";
                copy `CorrelationId` -> `ErrorResponsee`/`correlationId`;
                set `ErrorResponsee`/`serviceName` = "insertEmployee";
                set `ErrorResponsee`/`errorCode` = "Failure";
                drop `insertEmployeeOutput`;
            }
        }
    }
}
